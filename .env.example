# Environment-specific overrides for the root Makefile — also read by
# serverless-api-example/Makefile and event-driven-example/Makefile (the
# two examples with their own standalone Makefile), so REGISTRY/IMAGE_TAG/
# PODMAN etc. stay consistent whether you build via the root `make
# build-<example>` or by `cd`-ing into the example and running `make
# build` there directly.
#
# Copy this file to .env and fill in values for your cluster/registry —
# .env is gitignored, so it's safe to keep real values there (this is
# just Make variables, not a secrets store; don't put credentials here).
# Command-line overrides (e.g. `make deploy REGISTRY=...`) always take
# precedence over .env, which always takes precedence over the defaults
# baked into the Makefile.
#
# Format: plain KEY=value, no quotes, no spaces around `=` — this file is
# parsed as Make syntax (`-include .env`), not shell syntax.

# ---------------------------------------------------------------------------
# Container registry — used by build-serverless-api-example,
# build-event-driven-example, build-mcp-example (and their deploy-*
# counterparts, which reference the same image).
# ---------------------------------------------------------------------------
REGISTRY=quay.io/your-org
IMAGE_TAG=0.1.0

# ---------------------------------------------------------------------------
# OpenShift namespace/project the deploy-* targets install into.
# ---------------------------------------------------------------------------
NAMESPACE=docling

# ---------------------------------------------------------------------------
# Live-infrastructure URLs. Leave unset (blank or commented out) to have
# the targets that need them skip cleanly instead of failing — useful if
# you only have some of this infrastructure deployed.
# ---------------------------------------------------------------------------

# Route/URL of a deployed docling-serve instance (see docling-serve/).
# If unset and you're logged in via `oc`, test-docling-serve-examples
# auto-discovers it from the docling-serve Route in NAMESPACE.
# DOCLING_SERVE_URL=https://docling-serve-docling.apps.your-cluster.example.com

# Route/URL of a deployed LlamaStackDistribution (see rag-via-ogx-example/).
# LLAMA_STACK_URL=https://llamastack-docling.apps.your-cluster.example.com

# Data Science Pipelines endpoint (see batch-via-pipeline-example/).
# PIPELINES_ENDPOINT=https://ds-pipeline-docling.apps.your-cluster.example.com

# ---------------------------------------------------------------------------
# Advanced — rarely need to change these.
# ---------------------------------------------------------------------------

# Python version the shared venv is pinned to. Must match what Red Hat's
# RHOAI package index (see requirements.txt) publishes wheels for.
# DOCLING_PYTHON_VERSION=3.12

# Override if these tools aren't on PATH under their usual names — or to
# swap Podman for Docker: PODMAN=docker works everywhere this repo shells
# out to a container engine (build/push here are drop-in compatible
# between the two CLIs).
# PODMAN=podman
# HELM=helm
# OC=oc
